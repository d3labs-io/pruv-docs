# Private key of the sender wallet (without 0x prefix is fine, both formats accepted)
PRIVATE_KEY=

# Amount of USDT to bridge and deposit into RWA vault (human-readable, e.g., 1 = 1 USDT)
#
# The vault trades at 100 KAI : 1 USDT, so this mints TOKEN_AMOUNT * 100 KAI.
# To undo the mint, run scripts-redeem with that KAI amount (see its .env.example).
TOKEN_AMOUNT=1

# Optional: recipient address on Kaia for the final RWA tokens (defaults to sender)
RECIPIENT=

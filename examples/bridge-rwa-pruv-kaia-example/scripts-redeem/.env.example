# Private key of the sender wallet (without 0x prefix is fine, both formats accepted)
PRIVATE_KEY=

# Amount of RWA (KAI) tokens to redeem (human-readable, e.g., 1 = 1 KAI)
#
# The vault trades at 100 KAI : 1 USDT. To undo a mint of N USDT you must redeem
# N * 100 KAI — e.g. mint TOKEN_AMOUNT=0.4 produces 40 KAI, so redeem 40 here.
# Redeeming less leaves KAI stranded on Kaia and USDT locked in the vault.
TOKEN_AMOUNT=100

# Optional: recipient address on Kaia for the final USDT (defaults to sender)
RECIPIENT=
